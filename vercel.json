{
  "cleanUrls": true,
  "trailingSlash": false,
  "git": {
    "deploymentEnabled": {
      "codex/felix-r2-publish": false,
      "dev": false
    }
  },
  "headers": [
    {
      "source": "/media/:path*.([a-f0-9]{10}).:ext+",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/fonts/:path*.([a-f0-9]{10}).:ext+",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/media-manifest.json",
      "headers": [{ "key": "Cache-Control", "value": "public, no-cache" }]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.felixpy.com" }],
      "destination": "https://felixpy.com/:path*",
      "permanent": true
    }
  ]
}
