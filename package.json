    "@fontsource/lxgw-wenkai-tc": "^5.3.1",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@react-three/fiber": "^9.8.2",
    "@vercel/analytics": "^2.0.1",
    "gsap": "^3.15.1",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.78.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "name": "felix-studio",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "playwright test",
    "test:ci": "playwright test --grep-invert @webgl",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "format:staged": "lint-staged",
    "hooks:install": "npm run prepare",
    "check:commit": "node scripts/git/check-commit.mjs"
  },
  "lint-staged": {
    "*": "oxfmt --check --no-error-on-unmatched-pattern"
  },
  "private": true
}
